# Security headers for the public, static RWS concept demos.
# CSP deliberately allows case-study embedding from rocwebsolutions.com and
# local VS Code Live Server (localhost / 127.0.0.1, any port).
# Do not add X-Frame-Options: DENY or SAMEORIGIN: it would break RWS embeds.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'none'; frame-src 'none'; frame-ancestors 'self' https://rocwebsolutions.com https://www.rocwebsolutions.com http://localhost:* http://127.0.0.1:*; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()
